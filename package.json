{
  "name": "operation-sindoor-simulator",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "validate-data": "vitest run src/schemas",
    "build-data": "node scripts/build-geo.mjs && node scripts/targets.src.mjs && node scripts/events.src.mjs && node scripts/weapons.src.mjs && node scripts/build-symbols.mjs",
    "build-boundaries": "node scripts/build-boundaries.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
    "check-sources": "node scripts/check-sources.mjs",
    "build-admin1": "node scripts/build-admin1.mjs",
    "build:offline": "vite build --config vite.offline.config.ts && node scripts/package-offline.mjs",
    "test:offline": "playwright test --config playwright.offline.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.11",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.460.0",
    "mgrs": "^2.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "recharts": "^2.13.0",
    "tailwind-merge": "^2.5.4",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/geojson": "^7946.0.14",
    "@types/leaflet": "^1.9.14",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "milsymbol": "^2.2.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^2.1.5"
  }
}
